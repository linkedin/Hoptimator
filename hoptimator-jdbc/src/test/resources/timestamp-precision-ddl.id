!set outputformat mysql
!use util

# Verify TIMESTAMP precision survives DDL end-to-end (planner routed through
# HoptimatorTypeSystem, which raises the datetime precision ceiling to 9).
# Without the custom type system, TIMESTAMP(6)/(9) would be clamped to TIMESTAMP(3).
create table foo (ts0 TIMESTAMP, ts3 TIMESTAMP(3), ts6 TIMESTAMP(6), ts9 TIMESTAMP(9)) WITH (a 'b');
(0 rows modified)

!update

+------------+-----------+------------+------------+
| columnName | typeName  | columnSize | isNullable |
+------------+-----------+------------+------------+
| TS0        | TIMESTAMP | 0          | YES        |
| TS3        | TIMESTAMP | 3          | YES        |
| TS6        | TIMESTAMP | 6          | YES        |
| TS9        | TIMESTAMP | 9          | YES        |
+------------+-----------+------------+------------+
(4 rows)

!describe "DEFAULT"."FOO"

drop table foo;
(0 rows modified)

!update
