!set outputformat mysql
!use k8s

# castMode=assign: a character column may be coerced onto a scalar sink column, so projecting the
# VARCHAR stringField onto the INTEGER intField sink column succeeds with an injected CAST. The
# generated Flink INSERT wraps only the mismatched column; matched columns are left untouched.
insert into "VENICE"."test-store" ("KEY_name", "KEY_age", "intField") select "stringField" AS "KEY_name", "KEY" AS "KEY_age", "stringField" AS "intField" from "VENICE"."test-store-primitive";
apiVersion: flink.apache.org/v1beta1
kind: FlinkSessionJob
metadata:
  name: venice-test-store
spec:
  deploymentName: basic-session-deployment
  job:
    entryClass: com.linkedin.hoptimator.flink.runner.FlinkRunner
    args:
    - CREATE DATABASE IF NOT EXISTS `VENICE` WITH ()
    - CREATE TABLE IF NOT EXISTS `VENICE`.`test-store-primitive` (`KEY` INTEGER, `intField` INTEGER, `stringField` VARCHAR) WITH ('connector'='venice', 'key.fields'='KEY', 'key.fields-prefix'='', 'key.type'='PRIMITIVE', 'partial-update-mode'='true', 'storeName'='test-store-primitive', 'value.fields-include'='EXCEPT_KEY')
    - CREATE DATABASE IF NOT EXISTS `VENICE` WITH ()
    - CREATE TABLE IF NOT EXISTS `VENICE`.`test-store` (`KEY_name` VARCHAR, `KEY_age` INTEGER, `intField` INTEGER, `stringField` VARCHAR) WITH ('connector'='venice', 'key.fields'='KEY_name;KEY_age', 'key.fields-prefix'='KEY_', 'key.type'='RECORD', 'partial-update-mode'='true', 'storeName'='test-store', 'value.fields-include'='EXCEPT_KEY')
    - INSERT INTO `VENICE`.`test-store` (`KEY_name`, `KEY_age`, `intField`) SELECT `stringField` AS `KEY_name`, `KEY` AS `KEY_age`, CAST(`stringField` AS INTEGER) AS `intField` FROM `VENICE`.`test-store-primitive`
    jarURI: file:///opt/hoptimator-flink-runner.jar
    parallelism: 1
    upgradeMode: stateless
    state: running
!specify test-store

# castMode=assign still rejects the reverse (numeric -> character) coercion, which is not part of the
# character-to-scalar carve-out. Projecting the INTEGER intField onto the VARCHAR stringField sink
# column remains an error.
create or replace materialized view "VENICE"."test-store$cast-assign-bad" ("stringField") as select "intField" AS "stringField" from "VENICE"."test-store-primitive";
Incompatible types for sink column 'stringField': query produces INTEGER but sink expects VARCHAR (no safe conversion is available under castMode=assign).
!error
