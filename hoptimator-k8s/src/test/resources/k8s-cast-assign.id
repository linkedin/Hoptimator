!set outputformat mysql
!use k8s

create or replace table ads."cast_ok" ("member_id" bigint, "name" varchar);
(0 rows modified)

!update

# castMode=assign coerces the VARCHAR member_urn onto the BIGINT sink column with an injected CAST,
# while the matched VARCHAR column is left untouched.
insert into ads."cast_ok" ("member_id", "name") select member_urn AS "member_id", first_name AS "name" from profile.members;
apiVersion: flink.apache.org/v1beta1
kind: FlinkSessionJob
metadata:
  name: profile-database-castok
spec:
  deploymentName: basic-session-deployment
  job:
    entryClass: com.linkedin.hoptimator.flink.runner.FlinkRunner
    args:
    - CREATE DATABASE IF NOT EXISTS `PROFILE` WITH ()
    - CREATE TABLE IF NOT EXISTS `PROFILE`.`MEMBERS` (`FIRST_NAME` VARCHAR, `LAST_NAME` VARCHAR, `MEMBER_URN` VARCHAR, `COMPANY_URN` VARCHAR) WITH ('connector'='datagen', 'number-of-rows'='10')
    - CREATE DATABASE IF NOT EXISTS `ADS` WITH ()
    - CREATE TABLE IF NOT EXISTS `ADS`.`cast_ok` (`member_id` BIGINT, `name` VARCHAR) WITH ('connector'='blackhole')
    - INSERT INTO `ADS`.`cast_ok` (`member_id`, `name`) SELECT CAST(`MEMBER_URN` AS BIGINT) AS `member_id`, `FIRST_NAME` AS `name` FROM `PROFILE`.`MEMBERS`
    jarURI: file:///opt/hoptimator-flink-runner.jar
    parallelism: 1
    upgradeMode: stateless
    state: running
!specify cast_ok

drop table ads."cast_ok";
(0 rows modified)

!update
