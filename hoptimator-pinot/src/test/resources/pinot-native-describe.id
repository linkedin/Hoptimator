!set outputformat mysql
!use k8s

# Validates the Pinot -> Calcite read mapping against a table authored natively in Pinot (registered
# directly via the controller REST API in `make deploy-pinot`, NOT through Hoptimator DDL). This
# ensures our schema conversion isn't lossy independent of our own writer.
+------------+--------------------+------------+-------------+------------+
| columnName | typeName           | columnSize | columnScale | isNullable |
+------------+--------------------+------------+-------------+------------+
| id         | VARCHAR            | null       | null        | YES        |
| views      | INTEGER            | 10         | 0           | YES        |
| count      | BIGINT             | 19         | 0           | YES        |
| ratio      | DOUBLE             | 15         | null        | YES        |
| rate       | REAL               | 7          | null        | YES        |
| amount     | DECIMAL(19, 0)     | 19         | 0           | YES        |
| active     | BOOLEAN            | 1          | null        | YES        |
| payload    | VARBINARY          | null       | null        | YES        |
| tags       | RecordType() ARRAY | null       | null        | NO         |
| revenue    | DOUBLE             | 15         | null        | YES        |
| ts         | BIGINT             | 19         | 0           | YES        |
+------------+--------------------+------------+-------------+------------+
(11 rows)

!describe "PINOT"."native_types_table"
